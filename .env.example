# Copy to .env and fill in. Every service is optional — a card only appears
# once its settings are present. URLs default to http://SERVER_HOST:<default port>.

SERVER_HOST=10.10.10.10
DASHBOARD_TITLE=Unraid
# your timezone (e.g. Europe/London), used for "today" in the calendar
TZ=Etc/UTC
# true = sample data, no keys needed
DEMO_MODE=false

# --- Unraid (7.2+ built-in API, or the Unraid Connect plugin on older versions)
# Settings → Management Access → API Keys → create a key with the "viewer" role.
UNRAID_URL=http://10.10.10.10
UNRAID_API_KEY=

# --- AdGuard Home (the web UI login)
ADGUARD_URL=http://10.10.10.10:3000
ADGUARD_USERNAME=
ADGUARD_PASSWORD=

# --- Plex — see README for finding your token
PLEX_URL=http://10.10.10.10:32400
PLEX_TOKEN=

# --- Sonarr / Radarr / Bookshelf — Settings → General → API Key
SONARR_URL=http://10.10.10.10:8989
SONARR_API_KEY=
RADARR_URL=http://10.10.10.10:7878
RADARR_API_KEY=
BOOKSHELF_URL=http://10.10.10.10:8787
BOOKSHELF_API_KEY=

# --- Immich — Account Settings → API Keys (needs the server.statistics permission, or "all")
IMMICH_URL=http://10.10.10.10:2283
IMMICH_API_KEY=

# --- Tdarr (API key only needed if you turned on auth in Tdarr)
TDARR_URL=http://10.10.10.10:8265
TDARR_API_KEY=

# --- Home Assistant — Profile → Security → Long-lived access tokens
HA_URL=http://10.10.10.10:8123
HA_TOKEN=
# Buttons on the Quick controls card (lights, switches, fans, scenes, scripts).
# Leave empty to show your lights and scenes automatically.
HA_CONTROLS=
# Cameras to show (default: first 4 found)
HA_CAMERAS=
# Entities to hide anywhere on the dashboard
HA_EXCLUDE=
# Weather entity (default: first one found)
HA_WEATHER_ENTITY=
# Energy card — power sensors in W or kW (grid: positive = importing), battery in %
HA_SOLAR_POWER=
HA_HOME_POWER=
HA_GRID_POWER=
HA_BATTERY_LEVEL=

# --- Buttons: PIN for anything that changes things (entered once per device).
# Unlocking doors, the garage door and starting/stopping containers only
# appear when this is set. Lights and scenes work without it.
CONTROL_PIN=

# --- Download clients (optional)
QBITTORRENT_URL=
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=
SABNZBD_URL=
SABNZBD_API_KEY=

# --- Overseerr or Jellyseerr — Settings → General → API Key
OVERSEERR_URL=http://10.10.10.10:5055
OVERSEERR_API_KEY=

# --- Tautulli — Settings → Web Interface → API key
TAUTULLI_URL=http://10.10.10.10:8181
TAUTULLI_API_KEY=

# --- Uptime Kuma — make a Status Page and put its slug here (no key needed)
UPTIME_KUMA_URL=http://10.10.10.10:3001
UPTIME_KUMA_SLUG=

# --- Optional tuning
# days ahead to show
CALENDAR_DAYS=14
# days back to show
CALENDAR_PAST_DAYS=1
PLEX_RECENT_LIMIT=24
REQUEST_TIMEOUT_MS=8000
# PUBLIC_PLEX_URL=http://10.10.10.10:32400/web   # override where a card's title links to
